{
  "generators": [
    {
      "table": "customers",
      "name": "customers",
      "connection": "oracle",
      "localConfigs": {
        "maxEvents": 20000
      },
      "vars": {
        "id": {
          "_gen": "sequentialInteger",
          "startingFrom": 1
        },
        "city": {
          "_gen": "oneOf",
          "choices": REPLACE_CITIES_JSON
        },
        "signupMs": {
          "_gen": "uniformDistribution",
          "bounds": [
            1546300800000,
            {
              "_gen": "now"
            }
          ],
          "decimals": 0
        },
        "loginShare": {
          "_gen": "uniformDistribution",
          "bounds": [
            0,
            1
          ]
        }
      },
      "row": {
        "customer_id": {
          "_gen": "var",
          "var": "id"
        },
        "first_name": {
          "_gen": "string",
          "locale": ["pt", "BR"],
          "expr": "#{Name.firstName}"
        },
        "last_name": {
          "_gen": "string",
          "locale": ["pt", "BR"],
          "expr": "#{Name.lastName}"
        },
        "email": {
          "_gen": "string",
          "expr": "cliente#{id}@exemplo.invalid"
        },
        "email_verified": {
          "_gen": "weightedOneOf",
          "choices": [
            {"weight": 85, "value": 1},
            {"weight": 15, "value": 0}
          ]
        },
        "phone_number": {
          "_gen": "string",
          "expr": "#{regexify '[1-9]{2}9[0-9]{8}'}"
        },
        "phone_verified": {
          "_gen": "weightedOneOf",
          "choices": [
            {"weight": 70, "value": 1},
            {"weight": 30, "value": 0}
          ]
        },
        "address_line1": {
          "_gen": "string",
          "locale": ["pt", "BR"],
          "expr": "#{Address.streetAddress}"
        },
        "address_line2": {
          "_gen": "weightedOneOf",
          "choices": [
            {"weight": 60, "value": null},
            {"weight": 40, "value": {"_gen": "string", "expr": "Apto #{regexify '[1-9][0-9]{1,2}'}"}}
          ]
        },
        "postal_code": {
          "_gen": "string",
          "expr": "#{regexify '[0-9]{8}'}"
        },
        "latitude": {
          "_gen": "math",
          "expr": "lat + d",
          "names": {
            "lat": {"_gen": "var", "var": "city", "path": ["lat"]},
            "d": {"_gen": "uniformDistribution", "bounds": [-0.08, 0.08]}
          }
        },
        "longitude": {
          "_gen": "math",
          "expr": "lon + d",
          "names": {
            "lon": {"_gen": "var", "var": "city", "path": ["lon"]},
            "d": {"_gen": "uniformDistribution", "bounds": [-0.08, 0.08]}
          }
        },
        "city_id": {
          "_gen": "var",
          "var": "city",
          "path": ["city_id"]
        },
        "date_of_birth": {
          "_gen": "formatDateTime",
          "ms": {
            "_gen": "uniformDistribution",
            "bounds": [
              -315619200000,
              1104537600000
            ],
            "decimals": 0
          },
          "format": "yyyy-MM-dd"
        },
        "gender": {
          "_gen": "weightedOneOf",
          "choices": [
            {"weight": 48, "value": "female"},
            {"weight": 46, "value": "male"},
            {"weight": 2, "value": "other"},
            {"weight": 4, "value": "not_informed"}
          ]
        },
        "status": {
          "_gen": "weightedOneOf",
          "choices": [
            {"weight": 90, "value": "active"},
            {"weight": 7, "value": "inactive"},
            {"weight": 3, "value": "suspended"}
          ]
        },
        "signup_date": {
          "_gen": "formatDateTime",
          "ms": {"_gen": "var", "var": "signupMs"},
          "format": "yyyy-MM-dd HH:mm:ss"
        },
        "last_login": {
          "_gen": "formatDateTime",
          "ms": {
            "_gen": "math",
            "expr": "signup + share * (now - signup)",
            "names": {
              "signup": {"_gen": "var", "var": "signupMs"},
              "share": {"_gen": "var", "var": "loginShare"},
              "now": {"_gen": "now"}
            }
          },
          "format": "yyyy-MM-dd HH:mm:ss"
        }
      }
    },
